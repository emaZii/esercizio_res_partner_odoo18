<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_custom" model="ir.ui.view">
        <field name="name">res.partner.form.specifiche.pixora</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Creazione nuova scheda -->
            <xpath expr="//notebook" position="inside">
                <page string="SpecifichePixora">

                    <group string="Dati Cliente">
                        <field name="tipo_cliente"/>
                        <field name="num_identificativo"/>
                        <field name="codice_cliente" readonly="1"/>
                        <field name="data_creazione"/>
                    </group>
                </page>
         </xpath>
        </field>
    </record>
</odoo>
